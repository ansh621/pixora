<%- include('./partials/header') %>
<div class="gallery-container">
    <!-- Loop through user posts -->
    <% if (pp.length === 0) { %>
        <div class="p-4 text-center text-gray-500">
            <p>No posts found<% if (searchQuery) { %> for "<%= searchQuery %>"<% } %></p>
        </div>
    <% } else { %>
        <% pp.forEach(function(elem) { %>
        <div class="box">
            <a href="/show/<%= elem._id %>">
                <% 
                  let imgSrc = '/images/placeholder.svg';
                  if (elem.image) {
                    if (elem.image.startsWith('http://') || elem.image.startsWith('https://')) {
                      imgSrc = elem.image;
                    } else if (elem.image !== 'placeholder.svg') {
                      imgSrc = '/images/uploads/' + elem.image;
                    }
                  }
                %>
                <img src="<%= imgSrc %>" class="card-img-top w-full h-64 object-cover" alt="...">
            </a>
        </div>
        <% }); %>
    <% } %>
</div>
 <script src="https://code.jquery.com/jquery-3.3.1.js"></script>
         <script src="app.js"></script>
<%- include('./partials/footer') %>
