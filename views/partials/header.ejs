<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <% const foot = false;
   if(nav === true) { %>

    <div class="fixed w-full py-1 px-1 flex bg-rose-300 text-lg justify-evenly text-black items-center gap-2">

      <a title="Profile" aria-label="Profile" class="flex items-center justify-center w-12 h-12 border-2 border-rose-50 hover:border-rose-600 rounded-full" href="/profile">
        <i class="ri-user-line text-2xl"></i>
      </a>
      <a title="Feed" aria-label="Feed" class="flex items-center justify-center w-12 h-12 border-2 border-rose-50 hover:border-rose-600 rounded-full" href="/feed">
        <i class="ri-home-3-line text-2xl"></i>
      </a>
      
      <!-- Search Bar -->
      <form method="get" action="/feed" class="flex gap-1 items-center">
        <input 
          type="text" 
          name="search" 
          aria-label="Search posts" 
          placeholder="" 
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          class="px-3 py-2 border-2 border-rose-100 rounded-full focus:outline-none focus:ring-2 focus:ring-rose-600 bg-rose-50 text-black text-sm"
        >
        <button 
          type="submit" 
          class="w-12 h-12 flex items-center justify-center bg-rose-500 text-white border-2 border-rose-500 rounded-full hover:bg-rose-600 hover:border-rose-700 transition"
          title="Search"
          aria-label="Search"
        >
          <i class="ri-search-line text-xl"></i>
        </button>
      </form>
      
      <a title="Add Post" aria-label="Add Post" class="flex items-center justify-center w-12 h-12 border-2 border-rose-50 hover:border-rose-600 rounded-full" href="/add">
        <i class="ri-add-line text-2xl"></i>
      </a>
      
      <a title="Logout" aria-label="Logout" class="flex items-center justify-center w-12 h-12 border-2 border-rose-200 text-black hover:border-red-500 hover:text-red-500 rounded-full" href="/logout">
        <i class="ri-logout-box-r-line text-2xl"></i>
      </a>
      
  </div>
  
  <% } %>

<script>
  currentPage.classList.add('page-transition');
  

  setTimeout(() => {
      currentPage.classList.remove('page-transition');
  }, 400); // Adjust the delay to match the transition duration
  document.addEventListener('mousemove', (e) => {
    const cursor = document.querySelector('.cursor');
    cursor.style.left = e.pageX + 'px';
    cursor.style.top = e.pageY + 'px';
});

  
</script>
  